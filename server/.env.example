# Mishaki Server Environment Configuration
PROJECT_NAME="Mishaki E-Commerce API"
API_V1_STR="/api/v1"

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/mishaki_db"

# Fallback / Alternative SQLite Configuration (uncomment if you want to test without PostgreSQL)
# DATABASE_URL="sqlite:///./mishaki.db"

# Next.js Frontend Origins for CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
